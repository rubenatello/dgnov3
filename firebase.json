{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
          "npm --prefix \"$RESOURCE_DIR\" run build"
        ]
    }
  ],
  "hosting": {
    "public": "app/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/app.js",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/assets/app.css",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/assets/*-*.@(js|css|svg|png|jpg|jpeg|gif|ico|webp|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(svg|png|jpg|jpeg|gif|ico|webp|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/dashboard",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/dashboard/**",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/login",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "/dashboard",
        "destination": "/index.html"
      },
      {
        "source": "/dashboard/**",
        "destination": "/index.html"
      },
      {
        "source": "/api/articles",
        "function": "publicArticles"
      },
      {
        "source": "/api/search",
        "function": "publicSearch"
      },
      {
        "source": "/api/authors/**",
        "function": "publicAuthor"
      },
      {
        "source": "/api/contact",
        "function": "contact"
      },
      {
        "source": "/article/**",
        "function": "articlePage"
      },
      {
        "source": "/tracker/**",
        "function": "trackerPage"
      },
      {
        "source": "/trackers",
        "function": "publicPage"
      },
      {
        "source": "/reports",
        "function": "publicPage"
      },
      {
        "source": "/investigations",
        "function": "publicPage"
      },
      {
        "source": "/investigations/**",
        "function": "publicPage"
      },
      {
        "source": "/articles/**",
        "function": "publicPage"
      },
      {
        "source": "/tag/**",
        "function": "publicPage"
      },
      {
        "source": "/author/**",
        "function": "publicPage"
      },
      {
        "source": "/about",
        "function": "publicPage"
      },
      {
        "source": "/contact",
        "function": "publicPage"
      },
      {
        "source": "/editorial-standards",
        "function": "publicPage"
      },
      {
        "source": "/corrections",
        "function": "publicPage"
      },
      {
        "source": "/funding",
        "function": "publicPage"
      },
      {
        "source": "/privacy",
        "function": "publicPage"
      },
      {
        "source": "/search",
        "function": "publicPage"
      },
      {
        "source": "/sitemap.xml",
        "function": "sitemap"
      },
      {
        "source": "/news-sitemap.xml",
        "function": "newsSitemap"
      },
      {
        "source": "/rss.xml",
        "function": "feed"
      },
      {
        "source": "/atom.xml",
        "function": "feed"
      },
      {
        "source": "/feed.xml",
        "function": "feed"
      },
      {
        "source": "**",
        "function": "publicPage"
      }
    ]
  }
}
