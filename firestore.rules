rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Safe role check: prefer token.roles (authoritative), fall back to users/{uid}
    // but only if the document exists. Avoids runtime errors when the doc is
    // missing. Note: frequent get() calls can affect rule performance; prefer
    // setting custom claims for production.
    function hasRole(role) {
      return request.auth != null && (
        (request.auth.token.roles != null && request.auth.token.roles[role] == true)
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rolesMap[role] == true
        )
      );
    }

    function isWriter() {
      return hasRole('writer') || hasRole('editor') || hasRole('admin') || hasRole('superuser');
    }

    function isEditor() {
      return hasRole('editor') || hasRole('admin') || hasRole('superuser');
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('superuser');
    }

    function isInvestigationsEditor() {
      return hasRole('editor') || hasRole('superuser');
    }

    // Articles collection
    match /articles/{articleId} {
      // Anyone (including anonymous users) can read published articles
      allow read: if resource != null && resource.data.status == 'published';
      
      // Writers, editors, admins can read all articles (authenticated users only)
      allow read: if isSignedIn() && isWriter();
      
      // Writers can create articles. Additionally allow any signed-in user to
      // create an article for themselves (status == 'draft'). This enables 
      // autosave/draft workflows for authors who don't yet have the 'writer' role.
      allow create: if isWriter() || (
        isSignedIn() &&
        request.auth.uid == request.resource.data.authorId &&
        request.resource.data.status == 'draft'
      );

      // Single coherent update rule:
      // - Editors/admins can update any article.
      // - Writers can update their own articles.
      // - Signed-in non-writer authors can update their own drafts but may not
      //   change status (cannot publish).
      // Additionally, protect `publishedAt`: once set it may not be changed
      // except by editors; setting `publishedAt` for the first time is allowed
      // for the author if they are a writer (i.e., publishing) or for editors.
      allow update: if (
        // editors/admins: full access
        isEditor()
      ) || (
        // writers may update their own articles
        isWriter() && request.auth.uid == resource.data.authorId
      ) || (
        // non-writer signed-in authors may update their own drafts but may not
        // change the status (must remain 'draft')
        isSignedIn() &&
        request.auth.uid == resource.data.authorId &&
        resource.data.status == 'draft' &&
        request.resource.data.status == 'draft'
      )
      // Now enforce publishedAt constraints regardless of which branch matched
      && (
        // If publishedAt was never set, it's allowed to remain unset or be set
        // only if the actor is an editor or (a writer author who is publishing).
        (
          resource.data.publishedAt == null && (
            request.resource.data.publishedAt == null ||
            isEditor() ||
            (isWriter() && request.auth.uid == resource.data.authorId && request.resource.data.status == 'published')
          )
        )
        // If publishedAt was already set, it must remain unchanged unless editor
        || (
          resource.data.publishedAt != null && (
            request.resource.data.publishedAt == resource.data.publishedAt ||
            isEditor()
          )
        )
      );
      
      // Only editors and admins can delete
      allow delete: if isEditor();

      // Autosaves subcollection - version history for each article
      match /autosaves/{autosaveId} {
        // Article author, writers, editors, and admins can read autosaves
        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/articles/$(articleId)).data.authorId ||
          isWriter()
        );
        
        // Article author and writers can create/update autosaves
        // Allow creation without needing to check the parent article first
        allow create: if isSignedIn() && (
          request.auth.uid == request.resource.data.authorId ||
          isWriter()
        );
        
        // Allow updates to autosaves by author or writers
        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/articles/$(articleId)).data.authorId ||
          isWriter()
        );
        
        // Only editors and admins can delete autosaves (for cleanup)
        allow delete: if isEditor();
      }
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile and other user profiles (for author info)
      allow read: if true;
      
      // Users can update their own profile
      allow update: if isOwner(userId);
      
      // Anyone can create a user profile (for signup)
      allow create: if isSignedIn();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Authors/Users collection (legacy - keeping for compatibility)
    match /authors/{userId} {
      // Anyone can read author profiles
      allow read: if true;
      
      // Users can update their own profile
      allow update: if isOwner(userId);
      
      // Only admins can create/delete authors
      allow create, delete: if isAdmin();
    }

    // Comments collection
    match /comments/{commentId} {
      // Anyone can read approved comments
      allow read: if resource.data.status == 'approved';
      
      // Editors can read all comments (for moderation)
      allow read: if isEditor();
      
      // Signed-in & verified users can create comments (enforce types)
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.articleId is string
                    && request.resource.data.body is string
                    && request.resource.data.userName is string
                    && request.resource.data.status == 'approved';
      
      // Users can update their own comments (body and editedAt only)
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.articleId == resource.data.articleId;
      
      // Users can soft-delete their own comments
      allow delete: if isOwner(resource.data.userId);
      
      // Editors can update/delete any comment (moderation)
      allow update, delete: if isEditor();
    }

    // Comment Likes collection
    match /commentLikes/{likeId} {
      // Anyone can read comment likes
      allow read: if true;
      
      // Signed-in users can create/delete their own likes
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      
      allow delete: if isOwner(resource.data.userId);
    }

    // Reactions collection
    match /reactions/{reactionId} {
      // Anyone can read reactions
      allow read: if true;
      
      // Signed-in users can create reactions
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid;
      
      // Users can delete their own reactions
      allow delete: if isOwner(resource.data.userId);
    }

    // Article Views collection (for analytics)
    match /articleViews/{viewId} {
      // Only signed-in users can read view data (for analytics)
      allow read: if isSignedIn();
      
      // Anyone can create view records (for tracking)
      allow create: if true;
    }

    // Bookmarks collection (subcollection under user)
    match /bookmarks/{userId}/articles/{articleId} {
      // Users can only access their own bookmarks
      allow read, write: if isOwner(userId);
    }

    // Media collection
    match /media/{mediaId} {
      // Anyone can read media metadata
      allow read: if true;
      
      // Writers can create media
      allow create: if isWriter();
      
      // Writers can update their own media, editors can update any
      allow update: if isWriter() && 
        (request.auth.uid == resource.data.uploadedBy || isEditor());
      
      // Only editors can delete media
      allow delete: if isEditor();
    }

    // Investigations boards
    match /investigations/{boardId} {
      // Public read-only access
      allow read: if true;
      // Only editors and superusers can write
      allow write: if isInvestigationsEditor();
    }

    // Tags collection
    match /tags/{tagId} {
      // Anyone can read tags (for autocomplete)
      allow read: if true;
      
      // Writers can create new tags
      allow create: if isWriter();
      
      // Writers can update tag usage counts
      allow update: if isWriter();
      
      // Only editors can delete tags
      allow delete: if isEditor();
    }

    // DGNO (AI analysis) collection
    match /dgno/{articleId} {
      // Anyone can read approved DGNO analysis
      allow read: if true;
      
      // Only editors and admins can write DGNO data
      allow write: if isEditor();
    }

    // Donors collection
    match /donors/{userId} {
      // Users can read their own donor info
      allow read: if isOwner(userId);
      
      // System/functions can write (via service account)
      // Users cannot directly write to this collection
    }

    // Donations collection
    match /donations/{donationId} {
      // Users can read their own donations
      allow read: if isOwner(resource.data.userId);
      
      // Only backend functions can create donations (via webhook)
      // No direct user writes
    }
    // Subscriber profiles
    match /subscribers/{userId} {
      allow read: if true; // public can read subscriber metadata if desired
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Live Articles collection
    match /liveArticles/{liveArticleId} {
      // Anyone can read open live articles
      allow read: if resource.data.status == 'open';
      
      // Writers, editors, admins can read all live articles
      allow read: if isSignedIn() && isWriter();
      
      // Writers can create live articles
      allow create: if isWriter() && request.resource.data.authorId == request.auth.uid;
      
      // Writers can update their own live articles, editors/admins can update any
      allow update: if (
        isEditor() ||
        (isWriter() && request.auth.uid == resource.data.authorId)
      );
      
      // Only editors/admins can delete or close live articles
      allow delete: if isEditor();
      
      // Threads subcollection (for updates)
      match /threads/{threadId} {
        // Anyone can read threads on open live articles
        allow read: if get(/databases/$(database)/documents/liveArticles/$(liveArticleId)).data.status == 'open';
        
        // Writers/editors can read all threads
        allow read: if isSignedIn() && isWriter();
        
        // Writers can add threads to their own live articles
        allow create: if isWriter() && request.auth.uid == request.resource.data.authorId &&
          get(/databases/$(database)/documents/liveArticles/$(liveArticleId)).data.status == 'open';
        
        // Writers can update their own threads, editors can update any
        allow update: if (
          isEditor() ||
          (isWriter() && request.auth.uid == resource.data.authorId)
        );
        
        // Only editors can delete threads
        allow delete: if isEditor();
      }
    }

    // Trackers collection
    match /trackers/{trackerId} {
      // Anyone (including guests) can read active trackers for public viewing
      allow read: if resource != null && resource.data.isActive == true;
      
      // Writers, editors, admins can read all trackers (active and inactive)
      allow read: if isSignedIn() && isWriter();
      
      // Writers can create trackers
      allow create: if isWriter() && request.resource.data.createdBy == request.auth.uid;
      
      // Writers can update their own trackers, editors/admins can update any
      allow update: if (
        isEditor() ||
        (isWriter() && request.auth.uid == resource.data.createdBy)
      );
      
      // Only editors/admins can delete trackers
      allow delete: if isEditor();
    }

    // Tracker Incidents collection
    match /trackerIncidents/{incidentId} {
      // Anyone (including guests) can read active incidents from active trackers
      allow read: if resource != null && resource.data.status == 'active' && 
        get(/databases/$(database)/documents/trackers/$(resource.data.trackerId)).data.isActive == true;
      
      // Writers, editors, admins can read all incidents
      allow read: if isSignedIn() && isWriter();
      
      // Writers can create incidents
      allow create: if isWriter() && request.resource.data.createdBy == request.auth.uid;
      
      // Writers can update their own incidents, editors/admins can update any
      allow update: if (
        isEditor() ||
        (isWriter() && request.auth.uid == resource.data.createdBy)
      );
      
      // Only editors/admins can delete incidents
      allow delete: if isEditor();
    }

    // Default deny for anything not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
