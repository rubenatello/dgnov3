rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Role checks use the token.roles map (recommended). Storage rules cannot
    // safely call get() on Firestore, so we rely on auth token claims here.
    function hasRole(role) {
      return request.auth != null && (
        (request.auth.token.roles != null && request.auth.token.roles[role] == true)
      );
    }

    function isWriter() {
      return hasRole('writer') || hasRole('editor') || hasRole('admin') || hasRole('superuser');
    }

    function isEditor() {
      return hasRole('editor') || hasRole('admin') || hasRole('superuser');
    }
    
    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }
    
    function isValidSize(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // Assets folder (internal use only - logos, staff photos, etc.)
    match /assets/{allPaths=**} {
      // Anyone can read
      allow read: if true;
      
      // Only writers can upload
      allow write: if isWriter() && isValidSize(10);
    }

    // Images folder (article images)
    match /images/{allPaths=**} {
      // Anyone can read
      allow read: if true;
      
      // Allow any signed-in user to upload images (max 10MB).
      // Rationale: Storage cannot read Firestore for roles; some staff accounts
      // may rely on Firestore roles fallback. The dashboard routes are staff-gated
      // in the app, so this keeps UX unblocked while update/delete remain stricter.
      allow create: if isSignedIn() && 
        isValidImageType() && 
        isValidSize(10);
      
  // Update/delete: only the original uploader (stored in metadata) or an editor
  // can modify or remove objects. When uploading, the client should set
  // customMetadata.uploadedBy = auth.uid so ownership can be enforced here.
  allow update, delete: if isEditor() || (isWriter() && request.auth.uid == resource.metadata.customMetadata.uploadedBy);
    }

    // Generated public sharing images. Cloud Functions uses Admin SDK writes,
    // which bypass rules; clients can never create or replace these assets.
    match /social-cards/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Videos folder (article videos)
    match /videos/{allPaths=**} {
      // Anyone can read
      allow read: if true;
      
      // Allow any signed-in user to upload videos (max 100MB)
      allow create: if isSignedIn() && 
        isValidVideoType() && 
        isValidSize(100);
      
      // Writers can update/delete their own videos
      allow update, delete: if isWriter();
    }

    // Investigations folder (people/location images, evidence documents)
    // Note: Storage rules cannot read Firestore roles, so we allow any signed-in
    // user to upload. The dashboard UI already enforces editor-only access.
    match /investigations/{allPaths=**} {
      // Anyone can read (investigation boards are public)
      allow read: if true;
      
      // Any signed-in user can upload (dashboard enforces role check)
      allow create: if isSignedIn() && isValidSize(10);
      
      // Any signed-in user can update/delete (dashboard enforces role check)
      allow update, delete: if isSignedIn();
    }
  }
}
